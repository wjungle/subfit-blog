---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="zh-TW">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0 1em;
			}
			.hero-image {
				width: 100%;
				max-width: 1020px;
				margin: 0 auto;
				padding-top: 2em;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 100%;
				max-width: 760px;
				margin: auto;
				padding: 0 0 3em;
				color: rgb(var(--gray-dark));
				letter-spacing: 0.02em;
			}
			.title {
				margin-bottom: 1em;
				padding: 2em 0 1em;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.6em 0;
				font-family: var(--font-serif);
				font-weight: 900;
				line-height: 1.35;
			}
			.date {
				display: inline-block;
				margin-bottom: 1em;
				padding: 0.2em 0.9em;
				border-radius: 999px;
				background: var(--accent-soft);
				color: var(--accent-dark);
				font-size: 0.85em;
				font-weight: 600;
			}
			.last-updated-on {
				font-style: italic;
			}
			.prose :global(h2) {
				margin-top: 2em;
				padding-left: 0.6em;
				border-left: 5px solid var(--accent);
				line-height: 1.35;
			}
			.prose :global(h3) {
				margin-top: 1.6em;
			}
			.prose :global(img) {
				box-shadow: var(--box-shadow);
			}
			.prose :global(table) {
				border-collapse: collapse;
				font-size: 0.92em;
			}
			.prose :global(th),
			.prose :global(td) {
				border: 1px solid rgb(var(--gray-light));
				padding: 0.5em 0.8em;
			}
			.prose :global(th) {
				background: var(--cream-deep);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										更新於 <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
						<slot />
					<div class="cta-box">
						<p>想把文章裡提到的技巧直接練起來？</p>
						<a href="https://subfit.app" target="_blank" rel="noopener noreferrer">
							→ 免費試試 SubFit 沉浸式訓練
						</a>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
