---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostGrid from '../../components/PostGrid.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title={`文章列表 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 1120px;
				padding: 3em 1.25em 5em;
			}

			.page-head {
				text-align: center;
				margin-bottom: 2.5em;
			}

			.page-title {
				margin: 0.5em 0 0.3em;
				font-size: 2em;
				font-weight: 900;
			}

			.page-subtitle {
				color: rgb(var(--gray));
				font-size: 0.95em;
				margin: 0;
			}

			@media (max-width: 720px) {
				main {
					padding: 2em 1.25em 4em;
				}
				.page-title {
					font-size: 1.6em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-head">
				<span class="eyebrow">BLOG</span>
				<h1 class="page-title">所有文章</h1>
				<p class="page-subtitle">共 {posts.length} 篇 · 關於沉浸式英文訓練的技巧與心法</p>
			</div>
			<PostGrid posts={posts} headingTag="h2" />
		</main>
		<Footer />
	</body>
</html>
