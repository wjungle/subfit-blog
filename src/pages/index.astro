---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { faqs } from '../data/faqs';
import heroImage from '../assets/hero.jpg';

const APP_URL = 'https://subfit.app';
const APP_STORE_URL = 'https://apps.apple.com/tw/app/subfit/id6790284001';
const PLAY_URL = 'https://play.google.com/store/apps/details?id=app.subfit.app';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);

// App 截圖：把圖片丟進 src/assets/screenshots/ 就會自動出現在首頁（依檔名排序）。
// 資料夾是空的時候整個區塊不顯示。
const screenshotModules = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/screenshots/*.{png,jpg,jpeg,webp}',
	{ eager: true },
);
const screenshots = Object.keys(screenshotModules)
	.sort()
	.map((k) => screenshotModules[k].default);

// 訓練流程：對應 FAQ「SubFit 如何實作 100LS 的跟讀流程」
const steps = [
	{ name: '純聽', desc: '先不看字幕，專心聽聲音' },
	{ name: '看聽', desc: '對照字幕，找出沒聽到的地方' },
	{ name: '跟讀', desc: '跟著唸並錄下自己的聲音' },
	{ name: '對比', desc: '和 AI 自然發音逐句比較' },
	{ name: '複習', desc: '間隔重複，讓句子真正記住' },
];

const features = [
	{
		icon: 'import',
		title: '任何素材都能變課程',
		desc: '匯入 SRT 字幕、上傳影音自動轉字幕、拍書頁辨識文字、掃雜誌 QR，遇到的每一句都能拿來練。',
	},
	{
		icon: 'ear',
		title: '一句一句精聽',
		desc: '每句字幕拆成獨立訓練單位，反覆聽到真的聽懂，而不是「好像聽過」。',
	},
	{
		icon: 'mic',
		title: '跟讀錄音對比',
		desc: '錄下自己的聲音，和 AI 自然發音逐句對照，聽出自己哪裡不一樣。',
	},
	{
		icon: 'spark',
		title: 'AI 句子講解',
		desc: '卡住的句子一鍵講解文法、語意與用法，以繁體中文為母語設計。',
	},
	{
		icon: 'repeat',
		title: '間隔重複複習',
		desc: '依記憶曲線安排複習，Pro 方案還能匯出含 AI 分析的 Anki 卡片。',
	},
	{
		icon: 'devices',
		title: '手機、電腦都能練',
		desc: '網頁版免安裝即可開始，iOS / Android App 已上架。以英文為主，也支援日、韓、法、德等語言。',
	},
];

const plans = [
	{ name: 'Free', price: 'NT$0', note: '先試試看', perks: ['每月 50 句訓練', 'AI 講解每日限次', '登入可用影音匯入'] },
	{ name: 'Plus', price: 'NT$49', note: '/ 月・創始會員價', perks: ['每月 200 句訓練', '全部 TTS 語音', 'AI 講解無限'], featured: true },
	{ name: 'Pro', price: 'NT$99', note: '/ 月', perks: ['無限訓練', 'SRT / Anki 匯出', '支持 SubFit 持續開發'] },
];
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title={`${SITE_TITLE} — 讓你遇到的每一句，都能變成你的練習`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<!-- ============ Hero ============ -->
			<section class="hero">
				<!-- 背景的字幕條裝飾，呼應 logo 的圓角條 -->
				<div class="bars" aria-hidden="true">
					<span></span><span></span><span></span><span></span><span></span>
				</div>
				<div class="container hero-grid">
					<div class="hero-text">
						<span class="eyebrow">沉浸式語言訓練 App</span>
						<h1>
							<span class="phrase">讓你遇到的每一句，</span><em class="phrase">都能變成你的練習</em>
						</h1>
						<p class="lead">
							電影字幕・文章・照片・音檔・雜誌<br />
							一句句<strong>聽得懂・說得出・記得住</strong>
						</p>
						<div class="hero-actions">
							<a href={APP_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
								立即免費試用 →
							</a>
							<a href="#features" class="btn btn-ghost">看看怎麼練</a>
						</div>
						<div class="stores">
							<a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="store">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.8 1.2 1.8 2.6 3.1 2.6 1.3-.1 1.7-.8 3.3-.8 1.5 0 1.9.8 3.3.8 1.4 0 2.2-1.3 3-2.5 1-1.4 1.4-2.8 1.4-2.8s-2.4-1-2.4-4.2zM13.9 5c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3.1-1.5z"/></svg>
								<span><small>Download on the</small>App Store</span>
							</a>
							<a href={PLAY_URL} target="_blank" rel="noopener noreferrer" class="store">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5 3.5v17a1 1 0 0 0 1.5.86l14-8.5a1 1 0 0 0 0-1.72l-14-8.5A1 1 0 0 0 5 3.5z"/></svg>
								<span><small>GET IT ON</small>Google Play</span>
							</a>
						</div>
					</div>
					<div class="hero-visual">
						<Image
							src={heroImage}
							alt="SubFit 把書本、字幕、音檔轉成手機上一句句的練習"
							widths={[480, 800, 1200]}
							sizes="(max-width: 820px) 100vw, 560px"
							loading="eager"
						/>
					</div>
				</div>
			</section>

			<!-- ============ 理念 ============ -->
			<section class="belief container">
				<p class="quote">「大量聽」不等於「聽懂」。</p>
				<p>
					聽了幾百小時還是霧煞煞，問題通常不是聽得不夠多，而是沒有把一句話真正拆開來聽、開口說。
					SubFit 把 <a href="/blog/what-is-100ls/">100LS 跟讀法</a>的流程做成 App：一次只專心一句，從聽懂到說出口。
				</p>
			</section>

			<!-- ============ 訓練流程 ============ -->
			<section class="flow container">
				<div class="section-head">
					<span class="eyebrow">TRAINING FLOW</span>
					<h2>每一句都走過五個階段</h2>
				</div>
				<ol class="steps">
					{
						steps.map((s, i) => (
							<li style={`--i:${i}`}>
								<span class="step-no">{String(i + 1).padStart(2, '0')}</span>
								<span class="step-bar" />
								<strong>{s.name}</strong>
								<span class="step-desc">{s.desc}</span>
							</li>
						))
					}
				</ol>
			</section>

			<!-- ============ 功能 ============ -->
			<section id="features" class="features-wrap">
				<div class="container">
					<div class="section-head">
						<span class="eyebrow">FEATURES</span>
						<h2>從素材到開口，一個 App 搞定</h2>
					</div>
					<div class="features">
						{
							features.map((f) => (
								<article class="feature">
									<div class="feature-icon" aria-hidden="true">
										{f.icon === 'import' && (
											<svg viewBox="0 0 24 24"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
										)}
										{f.icon === 'ear' && (
											<svg viewBox="0 0 24 24"><path d="M3 14v-2a9 9 0 0 1 18 0v2M3 14a2 2 0 0 1 2-2h1v7H5a2 2 0 0 1-2-2v-3zm18 0a2 2 0 0 0-2-2h-1v7h1a2 2 0 0 0 2-2v-3z" /></svg>
										)}
										{f.icon === 'mic' && (
											<svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg>
										)}
										{f.icon === 'spark' && (
											<svg viewBox="0 0 24 24"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3zM19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16z" /></svg>
										)}
										{f.icon === 'repeat' && (
											<svg viewBox="0 0 24 24"><path d="M17 2l4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4M21 13v2a3 3 0 0 1-3 3H3" /></svg>
										)}
										{f.icon === 'devices' && (
											<svg viewBox="0 0 24 24"><rect x="2" y="4" width="15" height="11" rx="2" /><rect x="15" y="9" width="7" height="12" rx="1.5" /><path d="M6 19h7" /></svg>
										)}
									</div>
									<h3>{f.title}</h3>
									<p>{f.desc}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<!-- ============ App 截圖（有圖才顯示） ============ -->
			{
				screenshots.length > 0 && (
					<section class="shots container">
						<div class="section-head">
							<span class="eyebrow">SCREENSHOTS</span>
							<h2>實際畫面</h2>
						</div>
						<div class="shot-row">
							{screenshots.map((img) => (
								<div class="phone">
									<Image src={img} alt="SubFit App 畫面" widths={[280, 560]} sizes="260px" />
								</div>
							))}
						</div>
					</section>
				)
			}

			<!-- ============ 最新文章 ============ -->
			{
				posts.length > 0 && (
					<section class="latest container">
						<div class="section-head row">
							<div>
								<span class="eyebrow">BLOG</span>
								<h2>學習心法與技巧</h2>
							</div>
							<a href="/blog" class="see-all">
								查看全部 →
							</a>
						</div>
						<div class="post-grid">
							{posts.map((post) => (
								<a href={`/blog/${post.id}/`} class="post-card">
									<div class="post-thumb">
										{post.data.heroImage ? (
											<Image src={post.data.heroImage} alt="" width={640} height={320} />
										) : (
											<div class="thumb-placeholder" aria-hidden="true">
												<span />
												<span />
												<span />
											</div>
										)}
									</div>
									<div class="post-card-body">
										<p class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3 class="post-title">{post.data.title}</h3>
										<p class="post-desc">{post.data.description}</p>
										<span class="post-read">閱讀全文 →</span>
									</div>
								</a>
							))}
						</div>
					</section>
				)
			}

			<!-- ============ 價格 ============ -->
			<section class="pricing container">
				<div class="section-head">
					<span class="eyebrow">PRICING</span>
					<h2>免費開始，需要再升級</h2>
				</div>
				<div class="plans">
					{
						plans.map((p) => (
							<div class:list={['plan', { featured: p.featured }]}>
								{p.featured && <span class="badge">推薦</span>}
								<h3>{p.name}</h3>
								<p class="price">
									{p.price}
									<small>{p.note}</small>
								</p>
								<ul>
									{p.perks.map((perk) => (
										<li>{perk}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
				<p class="pricing-more"><a href="/pricing">查看完整方案比較 →</a></p>
			</section>

			<!-- ============ FAQ 精選 ============ -->
			<section class="faq container">
				<div class="section-head">
					<span class="eyebrow">FAQ</span>
					<h2>常見問題</h2>
				</div>
				<div class="faq-list">
					{
						faqs.slice(0, 4).map((f) => (
							<details>
								<summary>{f.question}</summary>
								<p>{f.answer}</p>
							</details>
						))
					}
				</div>
				<p class="pricing-more"><a href="/faq">更多問題 →</a></p>
			</section>

			<!-- ============ 底部 CTA ============ -->
			<section class="final-cta">
				<div class="container final-inner">
					<img src="/favicon.svg" alt="" width="72" height="72" class="final-icon" />
					<h2>今天就從一句開始</h2>
					<p>不用註冊，打開網頁就能練。手機版裝起來，通勤也能練。</p>
					<div class="hero-actions">
						<a href={APP_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
							開啟 SubFit 網頁版 →
						</a>
					</div>
					<div class="stores center">
						<a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="store dark">
							<span><small>Download on the</small>App Store</span>
						</a>
						<a href={PLAY_URL} target="_blank" rel="noopener noreferrer" class="store dark">
							<span><small>GET IT ON</small>Google Play</span>
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}
	.container {
		max-width: 1120px;
		margin: 0 auto;
		padding: 0 1.25em;
	}
	section {
		scroll-margin-top: 80px;
	}
	.section-head {
		text-align: center;
		margin-bottom: 2.5em;
	}
	.section-head h2 {
		margin-top: 0.5em;
		font-size: 2em;
		font-weight: 900;
	}
	.section-head.row {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		text-align: left;
	}

	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		overflow: hidden;
		padding: 4.5em 0 4em;
	}
	.bars {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.bars span {
		position: absolute;
		height: 14px;
		border-radius: 999px;
		background: var(--brand-gradient);
		opacity: 0.14;
	}
	.bars span:nth-child(1) { top: 12%; left: -4%; width: 220px; }
	.bars span:nth-child(2) { top: 18%; left: 8%; width: 90px; opacity: 0.1; }
	.bars span:nth-child(3) { bottom: 14%; right: -3%; width: 260px; }
	.bars span:nth-child(4) { bottom: 8%; right: 10%; width: 120px; opacity: 0.1; }
	.bars span:nth-child(5) { top: 6%; right: 30%; width: 14px; }

	.hero-grid {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1.05fr;
		align-items: center;
		gap: 3em;
	}
	.hero h1 {
		margin: 0.6em 0 0.5em;
		font-family: var(--font-serif);
		font-weight: 900;
		font-size: 2.9em;
		line-height: 1.3;
		letter-spacing: 0.02em;
	}
	/* 每個片語整段換行，避免手機上斷成「每一 / 句」 */
	.hero h1 .phrase {
		display: inline-block;
	}
	.hero h1 em {
		font-style: normal;
		background: var(--brand-gradient);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.lead {
		font-size: 1.1em;
		color: rgb(var(--gray));
		margin-bottom: 2em;
		line-height: 1.9;
	}
	.lead strong {
		color: rgb(var(--black));
	}
	.hero-actions {
		display: flex;
		gap: 0.8em;
		flex-wrap: wrap;
	}
	.hero-visual :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 24px;
		box-shadow: var(--box-shadow);
	}

	.stores {
		display: flex;
		gap: 0.7em;
		flex-wrap: wrap;
		margin-top: 1.6em;
	}
	.stores.center {
		justify-content: center;
	}
	.store {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.45em 1.1em 0.45em 0.9em;
		border-radius: 12px;
		background: var(--ink);
		color: var(--cream);
		text-decoration: none;
		line-height: 1.15;
		font-weight: 700;
		font-size: 0.95em;
		transition: transform 0.2s;
	}
	.store:hover {
		color: white;
		transform: translateY(-2px);
	}
	.store svg {
		width: 22px;
		height: 22px;
	}
	.store span {
		display: flex;
		flex-direction: column;
	}
	.store small {
		font-size: 0.62em;
		font-weight: 500;
		opacity: 0.8;
		letter-spacing: 0.03em;
	}
	.store.dark {
		background: transparent;
		border: 1.5px solid rgba(254, 247, 233, 0.35);
		padding: 0.45em 1.1em;
	}

	/* ---------- 理念 ---------- */
	.belief {
		max-width: 760px;
		text-align: center;
		padding-top: 2em;
		padding-bottom: 4em;
		color: rgb(var(--gray-dark));
	}
	.quote {
		font-family: var(--font-serif);
		font-weight: 900;
		font-size: 1.7em;
		color: rgb(var(--black));
		margin-bottom: 0.6em;
	}

	/* ---------- 流程 ---------- */
	.flow {
		padding-bottom: 5em;
	}
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 1em;
	}
	.steps li {
		display: flex;
		flex-direction: column;
		gap: 0.4em;
		padding: 1.3em 1.1em;
		background: var(--card);
		border: 1px solid rgb(var(--gray-light));
		border-radius: var(--radius);
	}
	.step-no {
		font-size: 0.8em;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: 0.1em;
	}
	/* 每一階段的字幕條逐漸變長，象徵「越聽越懂」 */
	.step-bar {
		display: block;
		height: 8px;
		border-radius: 999px;
		background: var(--brand-gradient);
		width: calc(30% + var(--i) * 17.5%);
		margin-bottom: 0.4em;
	}
	.steps strong {
		font-size: 1.2em;
		color: rgb(var(--black));
	}
	.step-desc {
		font-size: 0.85em;
		color: rgb(var(--gray));
		line-height: 1.6;
	}

	/* ---------- 功能 ---------- */
	.features-wrap {
		background: var(--cream-deep);
		padding: 5em 0;
	}
	.features {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25em;
	}
	.feature {
		padding: 1.8em 1.6em;
		background: var(--card);
		border-radius: var(--radius);
		border: 1px solid transparent;
		transition:
			transform 0.2s,
			box-shadow 0.2s,
			border-color 0.2s;
	}
	.feature:hover {
		transform: translateY(-4px);
		border-color: rgba(235, 105, 25, 0.3);
		box-shadow: var(--box-shadow);
	}
	.feature-icon {
		width: 48px;
		height: 48px;
		border-radius: 14px;
		display: grid;
		place-items: center;
		background: var(--brand-gradient);
		margin-bottom: 1em;
		box-shadow: var(--box-shadow-accent);
	}
	.feature-icon svg {
		width: 24px;
		height: 24px;
		fill: none;
		stroke: white;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
