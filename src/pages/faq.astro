---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { faqs } from '../data/faqs';

const title = 'SubFit 常見問題 FAQ — 100LS 跟讀法、SRT 字幕訓練';
const description = 'SubFit 常見問題：什麼是 100LS 跟讀法、如何匯入 SRT 字幕、支援哪些語言、是否免費等問題解答。';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.answer,
		},
	})),
};
---

<html lang="zh-TW">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0 1em;
			}
			.prose {
				width: 100%;
				max-width: 860px;
				margin: auto;
				padding: 2em 0 3em;
				color: rgb(var(--gray-dark));
			}
			.prose h1 {
				text-align: center;
				margin-bottom: 0.25em;
			}
			.prose .subtitle {
				text-align: center;
				color: rgb(var(--gray));
				font-size: 0.95em;
				margin-bottom: 2em;
			}
			.faq-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1.25em;
			}
			.faq-item {
				border: 1px solid rgba(var(--gray-light), 0.8);
				border-radius: 10px;
				padding: 1.25em 1.5em;
				background: var(--card);
			}
			.faq-item h2 {
				font-size: 1.05em;
				margin: 0 0 0.6em;
				color: rgb(var(--black));
			}
			.faq-item p {
				margin: 0;
				line-height: 1.75;
				font-size: 0.95em;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class="prose">
				<h1>常見問題 FAQ</h1>
				<p class="subtitle">關於 SubFit 與 100LS 跟讀法的常見疑問</p>
				<ul class="faq-list">
					{faqs.map((faq) => (
						<li class="faq-item">
							<h2>Q：{faq.question}</h2>
							<p>{faq.answer}</p>
						</li>
					))}
				</ul>
				<div class="cta-box">
					<p>準備好開始沉浸式訓練了嗎？</p>
					<a href="https://subfit.app" target="_blank" rel="noopener noreferrer">
						→ 免費試試 SubFit 沉浸式訓練
					</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
