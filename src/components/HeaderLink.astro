---
import type { HTMLAttributes } from 'astro/types';

// activePath：錨點連結（如 /#pricing）在對應獨立頁（/pricing）時也要亮
type Props = HTMLAttributes<'a'> & { activePath?: string };

const { href, activePath, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const current = '/' + (subpath?.[0] || '');
const isActive = href === pathname || href === current || activePath === current;
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
</style>
